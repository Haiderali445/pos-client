# ==============================================================================
# Hardware Point POS — Frontend Client Environment Variables
# ==============================================================================

# Port the React development server listens on (Default: 3000)
PORT=3000

# Base URL for REST API calls
# In development with CRA proxying: leave as "/api"
# In production with separate API domain: set to "https://api.yourdomain.com/api"
VITE_API_URL=/api
